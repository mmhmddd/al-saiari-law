NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://www.alsaiarilaw.com
# Optional comma-separated extra HTTPS frontend origins, for example Vercel previews.
CLIENT_URLS=https://alsaiarilaw.com,https://al-saiari-law.vercel.app

ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Al Saiari Law Firm

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=200
